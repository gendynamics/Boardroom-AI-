# Copy this file to .env and fill in the values. This demo only supports the PayPal Sandbox.

# PayPal Sandbox REST app credentials (Developer Dashboard > Apps & Credentials > Sandbox).
# For the Copilot's invoice and activity tools, also enable "Invoicing" and
# "Transaction search" under the app's Features section. Send money (Payouts) needs "Payouts".
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret

# AI provider: set ONE key. xAI Grok is used if both are set.
XAI_API_KEY=
# XAI_MODEL=grok-4.7
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# Optional: any other OpenAI-compatible Chat Completions endpoint (https, or http on localhost).
# AI_BASE_URL=

# Server. Open the app at APP_BASE_URL; PayPal redirects back to it.
PORT=3000
APP_BASE_URL=http://localhost:3000
# Optional: folder for the activity record (ledger.json). Default: data/ in the project.
# DATA_DIR=

# Negative testing (Sandbox only). Adds PayPal's PayPal-Mock-Response header to write requests.
ENABLE_NEGATIVE_TESTING=false
NEGATIVE_TEST_TYPE=INSUFFICIENT_FUNDS
# Allowed: INSUFFICIENT_FUNDS, INSTRUMENT_DECLINED, TRANSACTION_REFUSED,
#          INTERNAL_SERVER_ERROR, DUPLICATE_INVOICE_ID
