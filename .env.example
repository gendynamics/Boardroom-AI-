# Copy this file to .env and add your PayPal Sandbox app credentials.
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_secret
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# Negative Testing (Sandbox Only)
ENABLE_NEGATIVE_TESTING=false
NEGATIVE_TEST_TYPE=INSUFFICIENT_FUNDS
# Allowed options: INSUFFICIENT_FUNDS, INSTRUMENT_DECLINED, TRANSACTION_REFUSED,
# INTERNAL_SERVER_ERROR, DUPLICATE_INVOICE_ID
